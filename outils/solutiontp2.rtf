\cf0 2.1 Simple queries
\fs36 \
\
2.1.1 Give French Airports\'92 name and IATA code,\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0
\cf0 MATCH (a:Airport\{country:'France'\})\
RETURN a.name, a.IATA\
\
\pard\pardeftab720\partightenfactor0
\cf0 2.1.2 Give names and IATA codes of French Airline companies only when the IATA code exists and when it is an active Airline,\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0
\cf0 MATCH (a:Airline\{country:'France'\})\
WHERE a.IATA IS NOT NULL AND a.active = 'Y'\
RETURN a.name, a.IATA\
\
\pard\pardeftab720\partightenfactor0
\cf0 2.1.3 Names of French Airlines with at least one existing route,\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0
\cf0 MATCH (a:Airline\{country:'France'\}) <-- (r:Route)\
RETURN DISTINCT a.name\
\
\pard\pardeftab720\partightenfactor0
\cf0 2.1.4 Graph of routes which departure is Charles de Gaulle (CDG),\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0
\cf0 MATCH (cdg:Airport\{IATA:'CDG'\}) <-[:from]- (r:Route)\
RETURN cdg, r\
\
\pard\pardeftab720\partightenfactor0
\cf0 2.1.5 Graph of routes from CDG delivered by a A380 (equipment),\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0
\cf0 MATCH (cdg:Airport\{IATA:'CDG'\}) <-[:from]- (r:Route)\
WHERE r.equipment CONTAINS '380'\
RETURN cdg, r\
\
\pard\pardeftab720\partightenfactor0
\cf0 2.1.6 Cities and Countries which are the destinations of routes from CDG delivered by an A380,\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0
\cf0 MATCH (cdg:Airport\{IATA:'CDG'\}) <-[:from]- (r:Route) -[:to]-> (dest:Airport)\
WHERE r.equipment CONTAINS '380'\
RETURN dest.country, dest.city\
\
\pard\pardeftab720\partightenfactor0
\cf0 2.1.7 From the previous result, give the corresponding airlines name,\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0
\cf0 MATCH (cdg:Airport\{IATA:'CDG'\}) <-[:from]- (r:Route) -[:to]-> (dest:Airport),\
	(r) -[:by]-> (comp)\
WHERE r.equipment CONTAINS '380'\
RETURN dest.country, dest.city, comp.name\
\
\pard\pardeftab720\partightenfactor0
\cf0 2.1.8 Graph of routes from CDG to any French airport,\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0
